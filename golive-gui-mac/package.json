{
  "name": "golivebypass-mac",
  "version": "0.1.0",
  "private": true,
  "description": "Reativa o Go Live do Discord no macOS (Apple Silicon) via WireGuard full-device.",
  "main": "dist/main/main.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc -p tsconfig.json",
    "dist:mac": "npm run build:ts && electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
